  m_Script: {fileID: 11500000, guid: 8eb9d9fa0ccbe1b4cbcd2a1d889b806b, type: 3}
  m_Name: TenthDayConvo02
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  conversationName: TenthDayMainConversation
  lines:
  - speakerName: Randy
    line: If you manage to reach your quota... then all that is left is to <i>survive</i>
      your exit interview! Muahaha.
  - speakerName: Randy
    line: Oooh, ok, I heard it that time.
  repeatLine:
    speakerName: Randy
    line: "I've already given you a room key, and you can\u2019t carry more than
      one key at a time. Trust me-- we\u2019ve tried."
  altRepeatLine:
    speakerName: Randy
    line: "Another room, another opportunity! That\u2019s what I always say. Well,
      not always-- sometimes I say \u2018lock the doors.\u2019 Anyway, here is the
      next room key."
