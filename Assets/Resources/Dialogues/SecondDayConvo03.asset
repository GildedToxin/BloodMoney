  m_Script: {fileID: 11500000, guid: 8eb9d9fa0ccbe1b4cbcd2a1d889b806b, type: 3}
  m_Name: SecondDayConvo03
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  conversationName: SecondDayMainConversation
  lines:
  - speakerName: Randy
    line: "Oh, and if anyone in the gift shop hisses at you, don\u2019t panic-- it
      just means they\u2019re interested in the merchandise. Or you. Usually the
      merchandise."
  repeatLine:
    speakerName: Randy
    line: "Tick-tock. Freshness doesn\u2019t last forever, and neither does my patience.
      Use that room key and get harvesting."
  altRepeatLine:
    speakerName: Randy
    line: "Here\u2019s your next room key. And if you hear scratching, just ignore
      it. That\u2019s... pipes. Old building. Very scratchy pipes."
