  m_Script: {fileID: 11500000, guid: 8eb9d9fa0ccbe1b4cbcd2a1d889b806b, type: 3}
  m_Name: FourthDayConvo02
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  conversationName: FourthDayMainConversation
  lines:
  - speakerName: Randy
    line: Ok, here is a <b>room key</b>. Off you go-- and try not to trip over your
      own feet.
  repeatLine:
    speakerName: Randy
    line: "You still haven\u2019t used the room key I gave you earlier. I can hear
      it, you know-- it clinks in your pocket when you fidget. Stop fidgeting so
      much."
  altRepeatLine:
    speakerName: Randy
    line: "Here is the next room key. Oh-- and if you hear howling, pay it no mind.
      It\u2019s nothing you have to concern yourself with... for now."
