  m_Script: {fileID: 11500000, guid: 8eb9d9fa0ccbe1b4cbcd2a1d889b806b, type: 3}
  m_Name: ThirdDayConvo03
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  conversationName: ThirdDayMainConversation
  lines:
  - speakerName: Randy
    line: "Also, before you go-- if a customer offers you something that isn't money
      in return, <b>decline</b>. We have a strict \u2018no trades with the customers\u2019
      policy after... an incident."
  repeatLine:
    speakerName: Randy
    line: "Funny thing about keys-- they don't change, no matter how long you hold
      onto them. Use the key you already have, and I\u2019ll give you another one
      after."
  altRepeatLine:
    speakerName: Randy
    line: You have a good head on your shoulders-- and it's still firmly attached.
      Isn't that nice? Here, take this room key and keep up the good work.
