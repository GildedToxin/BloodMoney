  m_Script: {fileID: 11500000, guid: 8eb9d9fa0ccbe1b4cbcd2a1d889b806b, type: 3}
  m_Name: EighthDayConvo02
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  conversationName: EighthDayMainConversation
  lines:
  - speakerName: Randy
    line: "Oh yes, I almost forgot to ask-- you haven\u2019t tried to drink the water
      from the fountain, have you? That water isn\u2019t drinkable. It\u2019s not
      even water. I\u2019m not sure what it is, honestly."
  repeatLine:
    speakerName: Randy
    line: "Ah, I see you already have a room key. One at a time-- company policy.
      Go on, use it! Doors don\u2019t unlock themselves. Usually."
  altRepeatLine:
    speakerName: Randy
    line: Ah, you need another room key? Ok, let me grab one. The occupant is very
      quiet now, so take your time. Well, not too much time... there is a quota to
      hit.
